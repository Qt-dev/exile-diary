{
  "name": "exile-diary",
  "version": "1.11.14",
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.x",
    "npm": ">=11 <12"
  },
  "main": "./out/electron/main/index.js",
  "build": {
    "appId": "com.exilediary.reborn",
    "productName": "Exile Diary Reborn",
    "afterPack": "./scripts/afterPack.js",
    "protocols": [
      {
        "name": "Exile Diary",
        "schemes": [
          "exile-diary",
          "exilediary"
        ]
      }
    ],
    "files": [
      "out/**/*"
    ],
    "nativeRebuilder": "parallel",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "exile-diary-reborn-setup-v${version}.${ext}",
      "icon": "./src/renderer/assets/img/icons/win/ExileDiary.ico",
      "extraResources": [
        "eng.traineddata",
        {
          "from": "./src/main/db/extensions",
          "to": "db/extensions"
        }
      ]
    },
    "nsis": {
      "oneClick": "false",
      "allowElevation": "true",
      "allowToChangeInstallationDirectory": "true",
      "installerIcon": "./src/renderer/assets/img/icons/win/ExileDiary.ico",
      "uninstallerIcon": "./src/renderer/assets/img/icons/win/ExileDiary.ico",
      "installerHeaderIcon": "./src/renderer/assets/img/icons/win/ExileDiary.ico"
    },
    "linux": {
      "artifactName": "exile-diary-reborn_v${version}_amd64.${ext}",
      "target": [
        "flatpak",
        "AppImage"
      ],
      "executableName": "exile-diary",
      "icon": "./src/renderer/assets/img/icons/png",
      "category": "Utility",
      "maintainer": "qt-dev",
      "extraResources": [
        "eng.traineddata",
        {
          "from": "./src/main/db/extensions",
          "to": "db/extensions"
        }
      ],
      "asarUnpack": [
        "node_modules/sharp/**",
        "node_modules/@img/sharp-libvips-linux-x64/lib/**"
      ]
    },
    "flatpak": {
      "useWaylandFlags": true,
      "runtimeVersion": "24.08",
      "baseVersion": "24.08",
      "finishArgs": [
        "--share=ipc",
        "--socket=x11",
        "--socket=wayland",
        "--share=network",
        "--filesystem=host:ro",
        "--filesystem=home",
        "--talk-name=org.gnome.Screenshot",
        "--talk-name=org.freedesktop.portal.Screenshot",
        "--talk-name=org.freedesktop.portal.Desktop"
      ],
      "files": [
        [
          "./eng.traineddata",
          "lib/com.exilediary.reborn/resources/eng.traineddata"
        ],
        [
          "./src/main/db/extensions/regexp.so",
          "lib/com.exilediary.reborn/resources/db/extensions/regexp.so"
        ]
      ]
    }
  },
  "scripts": {
    "build": "npm run build:app",
    "predev": "npm run native:check",
    "start": "electron-vite preview",
    "test": "npm run test:main && npm run test:renderer",
    "test:main": "jest --config jest.config.js --selectProjects main --runInBand",
    "test:renderer": "vitest run --config vitest.renderer.config.ts",
    "test:app:smoke": "npm run build:app && npm run benchmark:app:start",
    "test:packaged-sidecars": "node ./scripts/smoke-packaged-sidecars.mjs",
    "test:packaged-renderer": "node ./scripts/smoke-packaged-renderer.mjs",
    "test:ui:smoke": "node ./scripts/run-ui-tests.mjs chromium",
    "test:ui:capture": "node ./scripts/run-ui-tests.mjs capture",
    "test:ui:install": "playwright install chromium",
    "test:watch": "vitest --config vitest.renderer.config.ts",
    "typecheck": "npm run typecheck:renderer && npm run typecheck:main",
    "typecheck:renderer": "npx tsc -p tsconfig.json --noEmit",
    "typecheck:main": "npx tsc -p src/main/tsconfig.json --noEmit",
    "postinstall": "electron-builder install-app-deps",
    "native:check": "node ./scripts/check-electron-native-deps.mjs",
    "package:dir": "npm run build:app && cross-env DEBUG=electron-builder electron-builder --dir -p never",
    "format": "prettier --write \"{src,test}/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"{src,test}/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "data:extract": "npm --prefix tools/poe-data-extractor run extract",
    "data:check": "npm --prefix tools/poe-data-extractor run check",
    "pricing:generate": "tsx tools/poe-ninja-publisher/cli.ts generate",
    "pricing:validate": "tsx tools/poe-ninja-publisher/cli.ts validate",
    "pricing:serve": "tsx tools/poe-ninja-publisher/cli.ts serve",
    "pricing:publish": "tsx tools/poe-ninja-publisher/cli.ts publish",
    "pricing:test": "jest --config tools/poe-ninja-publisher/jest.config.cjs --runInBand",
    "cloudflare:auth:dev": "wrangler dev --config server/cloudflare/wrangler.jsonc",
    "cloudflare:auth:deploy": "wrangler deploy --config server/cloudflare/wrangler.jsonc",
    "cloudflare:auth:test": "tsx --test server/cloudflare/test/auth-worker.test.ts",
    "cloudflare:auth:typecheck": "tsc -p server/cloudflare/tsconfig.json",
    "benchmark": "npm run benchmark:string-match",
    "benchmark:db": "npx tsx test/benchmarks/db/DbQueryBenchmark.ts",
    "benchmark:db:json": "npx tsx test/benchmarks/db/DbQueryBenchmark.ts --json",
    "benchmark:string-match": "cross-env EXILE_DIARY_SILENCE_BENCHMARK_LOGS=1 npx tsx test/benchmarks/string-match/ParserBenchmark.ts",
    "benchmark:string-match:json": "cross-env EXILE_DIARY_SILENCE_BENCHMARK_LOGS=1 npx tsx test/benchmarks/string-match/ParserBenchmark.ts --json",
    "benchmark:runtime-core:run-finalization": "npx tsx test/benchmarks/runtime-core/RunFinalizationBenchmark.ts",
    "benchmark:runtime-core:pricing": "npx tsx test/benchmarks/runtime-core/PricingBatchBenchmark.ts",
    "benchmark:runtime-core:stash": "npx tsx test/benchmarks/runtime-core/StashRefreshBenchmark.ts",
    "benchmark:ocr:scan-map-mods": "cross-env EXILE_DIARY_SILENCE_BENCHMARK_LOGS=1 npx tsx test/benchmarks/ocr/ScanMapModsBenchmark.ts",
    "benchmark:ocr:app-path": "cross-env EXILE_DIARY_SILENCE_BENCHMARK_LOGS=1 npx tsx test/benchmarks/ocr/ScanMapModsAppPathBenchmark.ts",
    "benchmark:app:start": "npx tsx test/benchmarks/app/AppLifecycleBenchmark.ts --mode=startup --json",
    "benchmark:app:idle": "npx tsx test/benchmarks/app/AppLifecycleBenchmark.ts --mode=idle-memory --json",
    "baseline:collect": "cross-env EXILE_DIARY_SILENCE_BENCHMARK_LOGS=1 npx tsx test/benchmarks/collectBaselines.ts",
    "baseline:collect:runtime-core": "cross-env EXILE_DIARY_SILENCE_BENCHMARK_LOGS=1 npx tsx test/benchmarks/runtime-core/collectRuntimeCoreBaselines.ts",
    "baseline:collect:ocr": "cross-env EXILE_DIARY_SILENCE_BENCHMARK_LOGS=1 npx tsx test/benchmarks/ocr/collectOcrBaselines.ts",
    "baseline:collect:ocr:app-path": "cross-env EXILE_DIARY_SILENCE_BENCHMARK_LOGS=1 npx tsx test/benchmarks/ocr/collectOcrAppPathBaselines.ts",
    "sync:electron-assets": "node ./scripts/sync-electron-assets.mjs",
    "dev": "node ./scripts/run-dev-with-recovery.mjs",
    "dev:raw": "cross-env EXILE_DIARY_USER_DATA_PATH=.tmp/dev-user-data concurrently -k \"node ./scripts/watch-electron-assets.mjs\" \"npx electron-vite dev --watch\"",
    "dev:portable": "cross-env PORTABLE=true concurrently -k \"node ./scripts/watch-electron-assets.mjs\" \"npx electron-vite dev --watch\"",
    "dev:ui": "vite --config vite.ui-test.config.ts",
    "build:app": "npx electron-vite build && npm run sync:electron-assets",
    "package:win": "npm run build:app && cross-env DEBUG=electron-builder electron-builder -p never",
    "package:portable": "npm run build:app && cross-env DEBUG=electron-builder electron-builder --win zip -c.win.artifactName=exile-diary-reborn-portable.zip -p never",
    "package:linux": "npm run build:app && cross-env DEBUG=@malept/flatpak-bundler electron-builder -p never"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "rules": {
      "no-throw-literal": "off"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "keywords": [
    "util",
    "functional",
    "server",
    "client",
    "browser"
  ],
  "author": "qt-dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/qt-dev/exile-diary.git"
  },
  "contributors": [],
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@mui/x-date-pickers": "^9.10.0",
    "@noble/hashes": "^1.3.3",
    "axios": "^1.18.1",
    "axios-cache-interceptor": "^1.12.0",
    "base64url": "^3.0.1",
    "better-sqlite3": "^12.11.1",
    "bottleneck": "^2.19.5",
    "case": "^1.6.3",
    "chokidar": "^4.0.3",
    "classnames": "^2.5.1",
    "conf": "^10.2.0",
    "dayjs": "^1.11.21",
    "electron-is-dev": "^2.0.0",
    "electron-log": "^5.4.4",
    "electron-overlay-window": "^3.3.1",
    "electron-updater": "^6.8.9",
    "fast-equals": "^4.0.3",
    "fastest-levenshtein": "^1.0.16",
    "file-saver": "^2.0.5",
    "html-to-image": "^1.11.13",
    "json-2-csv": "^5.5.11",
    "piscina": "^5.2.0",
    "ps-list": "^9.0.0",
    "randomstring": "^1.3.1",
    "sharp": "^0.35.3",
    "tail": "^2.2.6",
    "tesseract.js": "^6.0.1",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1098.0",
    "@babel/core": "^7.29.7",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@cloudflare/workers-types": "^5.20260730.1",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@mui/system": "^9.2.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/sqlite3": "^3.1.11",
    "@vitejs/plugin-react": "^4.7.0",
    "bfj": "^9.1.3",
    "concurrently": "^8.2.2",
    "cpy": "^11.1.0",
    "cpy-cli": "^5.0.0",
    "cross-env": "^7.0.3",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^12.0.3",
    "electron": "^41.10.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "eslint": "^8.57.1",
    "eslint-config-react-app": "^7.0.1",
    "fs-extra": "^11.3.6",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-resolve": "^30.0.5",
    "jest-watch-typeahead": "^3.0.1",
    "mobx": "^6.16.1",
    "mobx-react-lite": "^3.4.3",
    "postcss": "^8.5.25",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-normalize": "^13.0.1",
    "postcss-preset-env": "^10.6.1",
    "prettier": "^2.8.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-refresh": "^0.14.2",
    "react-router": "^7.18.1",
    "react-router-dom": "^7.18.1",
    "react-string-replace": "^1.1.1",
    "resolve": "^1.22.12",
    "semver": "^7.8.5",
    "ts-jest": "^29.4.11",
    "tslib": "^2.8.1",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7",
    "wait-on": "^7.2.0",
    "wrangler": "^4.115.0"
  }
}
